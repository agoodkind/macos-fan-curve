// Copy to local.xcconfig and fill in your values
// Find CERT_ID with: security find-identity -v -p codesigning
// Find DEVELOPMENT_TEAM at: https://developer.apple.com/account

CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = YOUR_TEAM_ID
BUNDLE_ID_PREFIX = com.example
HELPER_BUNDLE_ID = com.example.smcfanhelper
APP_BUNDLE_ID = com.example.fancurve

// Optional: sign the DMG itself after it is created.
// Usually the same identity as CODE_SIGN_IDENTITY.
DMG_SIGN_IDENTITY = Developer ID Application

// Sparkle feed configuration. SUPublicEDKey is safe to commit; the
// corresponding private key must stay out of the repo.
SPARKLE_FEED_URL = https://goodkind.io/fancurve/appcast.xml
SPARKLE_PUBLIC_ED_KEY =
