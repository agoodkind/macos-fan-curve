#!/usr/bin/env bash
set -euo pipefail

command_name="$(basename "$0")"

assert_no_deploy_secrets() {
    local environment_dump

    environment_dump="$(env)"
    if [[ "${SPARKLE_PRIVATE_KEY+x}" == "x" ]] \
        || [[ "${CLOUDFLARE_API_TOKEN+x}" == "x" ]] \
        || [[ "${CLOUDFLARE_ACCOUNT_ID+x}" == "x" ]] \
        || [[ "${environment_dump}" == *notasecret* ]] \
        || [[ "${environment_dump}" == *test-api-token* ]] \
        || [[ "${environment_dump}" == *test-account* ]]; then
        printf 'fixture: deploy secrets reached %s\n' "${command_name}" >&2
        exit 1
    fi
}

case "${command_name}" in
    curl)
        assert_no_deploy_secrets
        output_path=""
        previous_argument=""
        for argument in "$@"; do
            if [[ "${previous_argument}" == "--output" ]]; then
                output_path="${argument}"
            fi
            previous_argument="${argument}"
        done
        printf 'preserved sibling\n' > "${output_path}"
        printf 'curl %s\n' "$*" >> "${FAKE_LOG}"
        ;;
    make)
        assert_no_deploy_secrets
        printf 'make %s\n' "$*" >> "${FAKE_LOG}"
        if [[ "$*" == "generate-sparkle-appcast" ]]; then
            if [[ "$(<"${SPARKLE_PRIVATE_KEY_FILE}")" != "notasecret" ]]; then
                printf 'fixture: Sparkle key content did not match\n' >&2
                exit 1
            fi
            key_mode="$(stat -f '%Lp' "${SPARKLE_PRIVATE_KEY_FILE}")"
            if [[ "${key_mode}" != "600" ]]; then
                printf 'fixture: Sparkle key mode was %s\n' "${key_mode}" >&2
                exit 1
            fi
            printf 'generated current\n' \
                > "${FAKE_REPOSITORY_ROOT}/build/sparkle-updates/appcast.xml"
            printf 'key %s\n' "${SPARKLE_PRIVATE_KEY_FILE}" >> "${FAKE_LOG}"
        fi
        ;;
    npx)
        environment_dump="$(env)"
        if [[ "${SPARKLE_PRIVATE_KEY+x}" == "x" ]] \
            || [[ "${environment_dump}" == *notasecret* ]]; then
            printf 'fixture: Sparkle key reached npx\n' >&2
            exit 1
        fi
        if [[ "${PWD}" != "${FAKE_REPOSITORY_ROOT}/deploy/appcast-worker" ]]; then
            printf 'fixture: npx ran from %s\n' "${PWD}" >&2
            exit 1
        fi
        if [[ "${CLOUDFLARE_API_TOKEN}" != "test-api-token" ]] \
            || [[ "${CLOUDFLARE_ACCOUNT_ID}" != "test-account" ]]; then
            printf 'fixture: Cloudflare inputs did not reach npx\n' >&2
            exit 1
        fi
        printf 'npx %s\n' "$*" >> "${FAKE_LOG}"
        ;;
    *)
        printf 'fixture: unsupported command %s\n' "${command_name}" >&2
        exit 1
        ;;
esac
